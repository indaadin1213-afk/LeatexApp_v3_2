
using System;
using System.Drawing;
using System.Drawing.Drawing2D;
using System.Windows.Forms;
using LeatexApp.Services;

namespace LeatexApp.Controls
{
    public class ModernButton : Button
    {
        public Color BaseColor { get; set; } = ThemeService.Accent;
        public Color HoverColor { get; set; } = Color.FromArgb(0xE5,0x4A,0x4A);
        public int CornerRadius { get; set; } = 8;
        private bool _hover;
        public ModernButton(){ FlatStyle=FlatStyle.Flat; FlatAppearance.BorderSize=0; ForeColor=Color.White; BackColor=BaseColor; Cursor=Cursors.Hand; Padding=new Padding(10,6,10,6);}    
        protected override void OnMouseEnter(EventArgs e){ _hover=true; Invalidate(); base.OnMouseEnter(e);}    
        protected override void OnMouseLeave(EventArgs e){ _hover=false; Invalidate(); base.OnMouseLeave(e);}    
        protected override void OnPaint(PaintEventArgs pevent)
        {
            pevent.Graphics.SmoothingMode = SmoothingMode.AntiAlias;
            var rect = ClientRectangle; rect.Inflate(-1,-1);
            using var path = RoundedRect(rect, CornerRadius);
            using var brush = new SolidBrush(_hover ? HoverColor : BaseColor);
            pevent.Graphics.FillPath(brush, path);
            TextRenderer.DrawText(pevent.Graphics, Text, Font, rect, ForeColor, TextFormatFlags.HorizontalCenter | TextFormatFlags.VerticalCenter);
        }
        private GraphicsPath RoundedRect(Rectangle r, int radius){ int d=radius*2; var path=new GraphicsPath(); path.AddArc(r.Left,r.Top,d,d,180,90); path.AddArc(r.Right-d,r.Top,d,d,270,90); path.AddArc(r.Right-d,r.Bottom-d,d,d,0,90); path.AddArc(r.Left,r.Bottom-d,d,d,90,90); path.CloseFigure(); return path; }
    }
}
